# MongoDB (same database BetterAuth uses on the client)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/fixmate
DB_NAME=fixmate

# Shared secret: the Next.js client signs short-lived JWTs with it, this server verifies them
JWT_SECRET=change-me-to-a-long-random-string

# Stripe (test mode only)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Client origin(s) allowed by CORS - comma separated, no trailing slash
CLIENT_URL=http://localhost:3000

PORT=5000
